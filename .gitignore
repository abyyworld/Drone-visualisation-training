# Bytecode and build products
*.egg-info/
build/
dist/
.eggs/
# Environments
env/
# Test and tool caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
# Model weights and training runs. These are large, they are binary, and they
# are reproducible from training/ -- git is the wrong place for them. Keep the
# weights hash in the incident log instead (ModelInfo.weights_sha), which is
# what makes an old log replayable against the model that produced it.
models/
weights/
*.pt
*.onnx
*.engine
*.torchscript
# One exception, on purpose: archive/ holds the superseded turbine detector so the
# repository shows the trained-model route that was tried and why it was dropped. It is
# 10 MB, it is never loaded by anything, and archive/README.md says what it is. Nothing
# new should land there without an entry in that file.
!archive/**/*.onnx
# web/models/ is the deploy directory, not a training output, and git cannot re-include a
# file whose parent directory is excluded - so the directory itself has to come back first
# before the negations below mean anything.
!web/models/
!web/models/*.tflite
!web/models/*.md
!web/models/*.onnx
!web/models/manifest.json
# Datasets. Tens of gigabytes, licensed separately, and rebuilt by
# training/prepare_datasets.py from the sources listed in docs/VALIDATION.md.
data/
*.zip
*.tar
*.tar.gz
# Incident logs contain operational footage of real emergencies and the
# locations they happened at. They are records, they may be evidence, and they
# never belong in a public repository. Retention and handling: docs/SAFETY.md.
incidents/
# TLS material for the station. The private key must not leave the laptop; the
# certificate is regenerated per network by `python -m station certs`.
certs/
*.pem
*.key
*.crt
# Local configuration. config.example.yaml is the committed template; the
# working copy holds this department's IPs and paths.
config.yaml
config.local.yaml
# Editor and OS noise
.vscode/
.idea/
*.swp

