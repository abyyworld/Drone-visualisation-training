<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET covers two things: the provider engines, and the RTSP video from the
      controller, which is an IP stream on the local link rather than anything remote. With
      the on-device engine and no analysis, nothing leaves the tablet.

      No storage permission: the file picker returns a content:// URI the system has already
      granted, and recordings go to the app's own directory. No camera permission: the
      camera is on the drone, and this app never opens the tablet's own.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The Analyse screen's live tracking uses the tablet's own camera through the WebView.
      Declared optional: the Camera screen uses the drone's feed over the network and needs
      no local camera at all, and a device without one must still install the app.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      A recording has to survive the pilot switching to the flight software or the screen
      timing out. Without a foreground service Android stops the activity and, before long,
      kills the process, and the recording ends silently - which nobody discovers until they
      land. POST_NOTIFICATIONS is what puts the "recording" line in the shade on Android 13
      and later; refused, the recording still runs and there is simply no line.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.DroneInspection">

        <!-- The launcher is the menu; Camera and Analyse are both reached from it. -->
        <activity
            android:name=".MenuActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Landscape only, and configChanges handles rotation itself: letting the system
          recreate this activity would tear down the RTSP session and the encoder, so a
          tablet turned over mid-flight would drop the video and end the recording.
        -->
        <activity
            android:name=".LiveActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density" />

        <activity
            android:name=".LiveSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density" />

        <!-- Holds the process up while a recording is running and the app is not on
             screen. See RecordingService for why this is unavoidable. -->
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
