<?xml version="1.0" encoding="utf-8"?>
<!-- The notification icon. A filled circle, the universal record mark, drawn as a vector
     because a notification icon is tinted and masked by the system and a bitmap would be
     the wrong size on half the densities. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,12 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
</vector>
