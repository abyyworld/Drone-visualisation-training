<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      No action bar: the web app draws its own header, and a second one stacked above it
      wastes a strip of a tablet screen that is showing photographs.
    -->
    <style name="Theme.DroneInspection" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:windowBackground">@color/brand</item>
    </style>
</resources>
