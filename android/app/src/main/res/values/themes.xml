<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      No action bar: the web app draws its own header, and a second one stacked above it
      wastes a strip of a tablet screen that is showing photographs.
    -->
    <style name="Theme.DroneInspection" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:windowBackground">@color/brand</item>
    </style>

    <!-- Settings-form labels and hints, so the layout carries no inline styling. -->
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="FieldHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:alpha">0.7</item>
    </style>
</resources>
