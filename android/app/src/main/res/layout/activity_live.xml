<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Two video views, one of which is used.

         The SurfaceView is the one that should win. The pipeline owns the decoder's texture
         and renders it here itself, which is what lets the same texture go straight to the
         encoder without the frame ever coming back to the CPU.

         The TextureView is the fallback, kept because a GL pipeline that fails to come up on
         some device would otherwise mean a black screen in a field with a drone in the air.
         It reads frames back with getBitmap(), which is slower and always works. Exactly one
         of these is visible; see LiveActivity. -->
    <SurfaceView
        android:id="@+id/video_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextureView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <world.abyy.droneinspection.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:padding="10dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <!-- Down the right edge, where a thumb reaches on a handheld held in both hands. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="12dp">

        <Button
            android:id="@+id/record"
            android:layout_width="120dp"
            android:layout_height="76dp"
            android:layout_marginBottom="14dp"
            android:text="@string/start_recording" />

        <Button
            android:id="@+id/snapshot"
            android:layout_width="120dp"
            android:layout_height="76dp"
            android:layout_marginBottom="14dp"
            android:text="@string/take_photo" />

        <!-- Shrinks to a small movable window so the drone's feed, and its boxes, stay
             visible over the flight software. Tracking and recording carry straight on.

             Two windows behind this one button. With permission to draw over other apps it
             is PopoutWindow, which can be dragged and resized; without, it is Android's own
             picture-in-picture, which on this tablet is one size and cannot be changed. -->
        <Button
            android:id="@+id/pip"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:text="@string/small_window" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Hidden while recording, so a half-written file cannot be walked away from. -->
        <Button
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/back_to_menu" />

        <Button
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings" />
    </LinearLayout>
</FrameLayout>
