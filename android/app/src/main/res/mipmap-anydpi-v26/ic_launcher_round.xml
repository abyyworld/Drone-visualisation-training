<?xml version="1.0" encoding="utf-8"?>
<!--
    The adaptive icon. Without this file Android 8 and later take the legacy bitmap and
    shrink it inside a white circle, which is why the icon looked like a placeholder no
    matter what the bitmap contained.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/brand" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
